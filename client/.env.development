# Public client settings for `npm run dev`. Everything here ends up in the browser:
# never put a secret in this file. Secrets live only in server/.env.

# Empty: requests go to /api on the Vite dev server, which proxies to http://localhost:3000.
VITE_API_URL=

# true: answer every API call from src/api/mocks/ (no server needed).
VITE_USE_MOCKS=false

# Optional, mocks only: ai (default) or fallback, which evaluation response the mock returns.
# VITE_MOCK_EVALUATION=ai
