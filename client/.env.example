# Client environment variables. Copy to .env.local to override .env.development.
# Every VITE_ variable is PUBLIC: Vite inlines it into the browser bundle.
# Never put a secret (LLM_API_KEY, SUPABASE_SERVICE_KEY, ...) here. Secrets live only in server/.env.

# Base URL of the Express API. Empty means same origin (/api, proxied by Vite in dev and preview).
VITE_API_URL=

# true answers every API call from src/api/mocks/ instead of the server.
VITE_USE_MOCKS=false

# Mocks only: ai or fallback, which evaluation response the mock returns (default ai).
VITE_MOCK_EVALUATION=
